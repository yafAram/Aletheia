# Requerido. Genera un secreto aleatorio largo, distinto al de la API.
ALETHEIA_DESKTOP_TOKEN=CAMBIA_ESTO_POR_UN_TOKEN_ALEATORIO_LARGO
# Solo localhost por defecto. No cambies a 0.0.0.0 hasta configurar firewall y red confiable.
ALETHEIA_DESKTOP_HOST=127.0.0.1
ALETHEIA_DESKTOP_PORT=8765
ALETHEIA_DESKTOP_MAX_CAPTURE_WIDTH=1920
ALETHEIA_DESKTOP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Opcional: reemplaza la lista por un objeto JSON alias:[ejecutable,arg1,...]
# ALETHEIA_DESKTOP_ALLOWED_APPS={"notepad":["notepad.exe"],"calculator":["calc.exe"]}
